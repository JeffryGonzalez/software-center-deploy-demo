    {
      "id": "8q5q8V13fk2TI6LQp4Img",
      "type": "text",
      "x": 627,
      "y": 1354,
      "width": 433.5596923828125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 645521904,
      "version": 128,
      "versionNonce": 274489328,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779806229456,
      "link": null,
      "locked": false,
      "text": "create a namespace for each \"app\" that has:\n    - it's own \"fantasy\" file system.\n    - limit its memory\n    - processor\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "create a namespace for each \"app\" that has:\n    - it's own \"fantasy\" file system.\n    - limit its memory\n    - processor\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qyVATyCAnx-UCud59KmLu",
      "type": "text",
      "x": 496,
      "y": 1564,
      "width": 735.5794677734375,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aQ",
      "roundness": null,
      "seed": 2028938736,
      "version": 349,
      "versionNonce": 188604912,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779806410187,
      "link": null,
      "locked": false,
      "text": "Docker - makes it so you don't have meetings to configure this stuff with \nneck-beard rude-ass linux admins (like Shawn)\n\n\nDockerfile\n    - declaratively stating what you need \n\n    - Container:\n        - it protects the contents from the outside.\n        - it contains the \"environment\" starting right above the kernel\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Docker - makes it so you don't have meetings to configure this stuff with \nneck-beard rude-ass linux admins (like Shawn)\n\n\nDockerfile\n    - declaratively stating what you need \n\n    - Container:\n        - it protects the contents from the outside.\n        - it contains the \"environment\" starting right above the kernel\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
